# Base URL of the SINACOL automation server (the `server` repo).
#
# Astro only exposes variables prefixed with PUBLIC_ to client-side code, so this
# REPLACES the old VITE_SINACOL_SERVER_URL (Vite SPA era). Update the Coolify build
# arg / environment accordingly when deploying the Astro build.
#
# Required in production builds; without it the website shows a configuration error
# instead of silently falling back to localhost. In development it may be left empty
# and the site will fall back to http://localhost:3001.
PUBLIC_SINACOL_SERVER_URL=

# Transitional: the flow code still reads VITE_SINACOL_SERVER_URL until A3 migrates
# it to PUBLIC_SINACOL_SERVER_URL. Set both during the transition if you build locally.
VITE_SINACOL_SERVER_URL=
