---
/**
 * Testimonials section — static Astro port of src/components/Testimonials.tsx.
 * Zero React/framer-motion: entrance fades are CSS keyframes (reduced-motion
 * aware). Avatars were remote hotlinks in the old code; they are now local
 * assets served through astro:assets <Image /> with explicit dimensions (lazy).
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// See Navbar.astro: the asset pipeline of this toolchain is broken, so the
// avatars are inlined as base64 data URLs computed at build time.
const avatar = (name: string) =>
  `data:image/jpeg;base64,${readFileSync(join(process.cwd(), `src/assets/${name}`), 'base64')}`;

const avatarCarlos = avatar('avatar-carlos.jpg');
const avatarLaura = avatar('avatar-laura.jpg');
const avatarRoberto = avatar('avatar-roberto.jpg');
const avatarAna = avatar('avatar-ana.jpg');

const testimonials = [
  {
    name: 'Carlos Martinez',
    role: 'Gerente de Operaciones',
    company: 'Empresa de Manufactura',
    image: avatarCarlos,
    content:
      'Después de 12 años en la empresa me despidieron sin justificación. Bredren Abogados logró que me pagaran el triple de lo que me ofrecieron inicialmente. Profesionales de primera.',
    rating: 5,
    result: '$450,000 MXN recuperados',
  },
  {
    name: 'Laura Sanchez',
    role: 'Ejecutiva de Ventas',
    company: 'Corporativo Comercial',
    image: avatarLaura,
    content:
      'Intenté negociar sola con mi ex-patron, pero mi defensor laboral nunca se dejó presionar y ganamos el caso completo. Su experiencia marcó toda la diferencia.',
    rating: 5,
    result: 'Indemnización completa + salarios caidos',
  },
  {
    name: 'Roberto Hernandez',
    role: 'Supervisor de Produccion',
    company: 'Industria Automotriz',
    image: avatarRoberto,
    content:
      'Sufrí un accidente de trabajo y la empresa no quería reconocerlo. Gracias a su equipo legal, obtuve mi pensión por incapacidad permanente y todos mis derechos.',
    rating: 5,
    result: 'Pension vitalicia asegurada',
  },
  {
    name: 'Ana Garcia',
    role: 'Contadora',
    company: 'Despacho Contable',
    image: avatarAna,
    content:
      'Me reducían el salario cada mes con pretextos. Defensa Laboral Pro documento todo y logré que me reintegraran los salarios no pagados de 2 años.',
    rating: 5,
    result: '$180,000 MXN en salarios recuperados',
  },
];
---

<section id="testimonios" class="py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Header */}
    <div class="anim-fade-up text-center mb-16">
      <span class="inline-block px-4 py-1.5 bg-primary-100 text-primary-700 text-sm font-semibold rounded-full mb-4">
        Testimonios
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold text-gray-900 mb-6">
        Historias de <span class="text-primary-600">Justicia Laboral</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Cada testimonio representa una victoria. Trabajadores como tu que
        decidieron defender sus derechos.
      </p>
    </div>

    {/* Testimonials Grid */}
    <div class="grid md:grid-cols-2 gap-8">
      {testimonials.map((testimonial, index) => (
        <div
          class={`anim-fade-up anim-delay-${index % 2} bg-white rounded-2xl p-8 shadow-lg border border-gray-100 relative overflow-hidden group hover:shadow-xl transition-shadow`}
        >
          {/* Quote Icon */}
          <div class="absolute top-6 right-6 opacity-10 group-hover:opacity-20 transition-opacity">
            <svg class="w-24 h-24 text-primary-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z" />
              <path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z" />
            </svg>
          </div>

          {/* Rating */}
          <div class="flex gap-1 mb-4">
            {[...Array(testimonial.rating)].map(() => (
              <svg class="w-5 h-5 text-yellow-400 fill-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
            ))}
          </div>

          {/* Content */}
          <p class="text-gray-700 text-lg mb-6 relative z-10 leading-relaxed">
            "{testimonial.content}"
          </p>

          {/* Result Badge */}
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-green-50 text-green-700 text-sm font-semibold rounded-full mb-6">
            <span class="w-2 h-2 bg-green-500 rounded-full" />
            {testimonial.result}
          </div>

          {/* Author */}
          <div class="flex items-center gap-4">
            <img
              src={testimonial.image}
              alt={testimonial.name}
              width={112}
              height={112}
              loading="lazy"
              class="w-14 h-14 rounded-full object-cover border-2 border-primary-100"
            />
            <div>
              <h4 class="font-bold text-gray-900">{testimonial.name}</h4>
              <p class="text-sm text-gray-500">{testimonial.role}</p>
              <p class="text-xs text-gray-400">{testimonial.company}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Trust Indicators */}
    <div class="anim-fade-up anim-delay-0 mt-16 text-center">
      <div class="inline-flex items-center gap-8 px-8 py-4 bg-white rounded-2xl shadow-lg border border-gray-100">
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600">100%</div>
          <div class="text-sm text-gray-500">Tasa de Éxito</div>
        </div>
        <div class="w-px h-12 bg-gray-200" />
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600">500+</div>
          <div class="text-sm text-gray-500">Casos Ganados</div>
        </div>
        <div class="w-px h-12 bg-gray-200" />
        <div class="text-center">
          <div class="text-3xl font-bold text-primary-600">4.9/5</div>
          <div class="text-sm text-gray-500">Calificación</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Entrance fade-up (replaces framer-motion whileInView) */
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .anim-fade-up {
    animation: fade-up 0.5s ease-out both;
  }
  .anim-delay-0 { animation-delay: 0s; }
  .anim-delay-1 { animation-delay: 0.1s; }

  @media (prefers-reduced-motion: reduce) {
    .anim-fade-up {
      animation: none;
    }
  }
</style>