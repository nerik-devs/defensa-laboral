---
/**
 * Footer section — static Astro port of src/components/Footer.tsx.
 * Zero React/framer-motion: the floating WhatsApp entrance is a CSS keyframe
 * (reduced-motion aware), hover effects are plain Tailwind transitions.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// See Navbar.astro: the asset pipeline of this toolchain is broken, so the
// logo is inlined as a base64 data URL computed at build time.
const logo = `data:image/webp;base64,${readFileSync(
  join(process.cwd(), 'src/assets/bredren-abogados-logo.webp'),
  'base64'
)}`;

const currentYear = new Date().getFullYear();
---

<footer id="footer" class="bg-gray-950 text-gray-300 py-16 border-t border-gray-900">
  <div class="container mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 lg:gap-16">
      {/* Brand - Takes 2 columns */}
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center gap-2 mb-6">
          <img
            src={logo}
            alt="Bredren Abogados"
            width={336}
            height={185}
            loading="lazy"
            class="w-40 h-auto"
          />
        </div>
        <p class="text-gray-400 mb-8 max-w-sm leading-relaxed">
          Más de 15 años defendiendo los derechos de los trabajadores mexicanos.
          Tu justicia laboral es nuestra misión.
        </p>
        <div class="flex gap-4">
          {/* Facebook */}
          <a
            href="https://www.facebook.com/BredrenAbogados/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook de Bredren Abogados"
            class="h-10 w-10 rounded-full bg-gray-900 flex items-center justify-center hover:bg-brand-600 hover:text-white transition-all"
          >
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
          </a>
          {/* Instagram */}
          <a
            href="https://www.instagram.com/bredrenabogados/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Bredren Abogados"
            class="h-10 w-10 rounded-full bg-gray-900 flex items-center justify-center hover:bg-brand-600 hover:text-white transition-all"
          >
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
            </svg>
          </a>
          {/* X / Twitter */}
          <a
            href="https://x.com/BredrenAbogados"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter) de Bredren Abogados"
            class="h-10 w-10 rounded-full bg-gray-900 flex items-center justify-center hover:bg-brand-600 hover:text-white transition-all"
          >
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />
            </svg>
          </a>
        </div>
      </div>

      {/* Navigation */}
      <div>
        <h4 class="text-white font-bold mb-6 text-lg">Navegación</h4>
        <ul class="space-y-4">
          <li>
            <a href="#inicio" class="text-gray-400 hover:text-gold-400 transition-colors flex items-center gap-2">
              Inicio
            </a>
          </li>
          <li>
            <a href="#servicios" class="text-gray-400 hover:text-gold-400 transition-colors flex items-center gap-2">
              Servicios
            </a>
          </li>
          <li>
            <a href="#consultas" class="text-gray-400 hover:text-gold-400 transition-colors flex items-center gap-2">
              Consultas
            </a>
          </li>
          <li>
            <a href="#testimonios" class="text-gray-400 hover:text-gold-400 transition-colors flex items-center gap-2">
              Testimonios
            </a>
          </li>
          <li>
            <a href="#contacto" class="text-gray-400 hover:text-gold-400 transition-colors flex items-center gap-2">
              Contacto
            </a>
          </li>
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h4 class="text-white font-bold mb-6 text-lg">Contacto Directo</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 group">
            <div class="mt-1 h-8 w-8 rounded bg-gray-900 flex items-center justify-center group-hover:bg-gold-500/20 transition-colors">
              <svg class="h-4 w-4 text-gold-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </div>
            <a href="tel:+528717795509" class="block">
              <span class="block text-sm text-gray-500">Llámanos</span>
              <span class="text-gray-300 group-hover:text-white transition-colors">+52 (871) 779 5509</span>
            </a>
          </li>
          <li class="flex items-start gap-3 group">
            <div class="mt-1 h-8 w-8 rounded bg-gray-900 flex items-center justify-center group-hover:bg-gold-500/20 transition-colors">
              <svg class="h-4 w-4 text-gold-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <a href="mailto:contacto@bredrenabogados.com" class="block">
              <span class="block text-sm text-gray-500">Escríbenos</span>
              <span class="text-gray-300 group-hover:text-white transition-colors">contacto@bredrenabogados.com</span>
            </a>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-1 h-8 w-8 rounded bg-gray-900 flex items-center justify-center">
              <svg class="h-4 w-4 text-gold-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div>
              <span class="block text-sm text-gray-500">Visítanos</span>
              <span class="text-gray-300">Av Allende 275 A Pte, Torreón, Coahuila</span>
            </div>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div class="border-t border-gray-900 mt-16 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-600">
      <p>&copy; {currentYear} Bredren Abogados - Defensa Laboral. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-gray-400 transition-colors">Aviso de Privacidad</a>
        <a href="#" class="hover:text-gray-400 transition-colors">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>

{/* Floating WhatsApp Button */}
<a
  href="https://wa.me/528717795509"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  class="wa-float fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-500 rounded-full flex items-center justify-center shadow-lg shadow-green-500/30 hover:bg-green-600 hover:scale-110 active:scale-95 transition-all"
>
  <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
  </svg>
</a>

<style>
  /* Floating WhatsApp entrance (replaces framer-motion initial/animate) */
  @keyframes wa-in {
    from {
      opacity: 0;
      transform: translateY(100px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .wa-float {
    animation: wa-in 0.6s ease-out 1s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float {
      animation: none;
    }
  }
</style>